table_settings></tab_browse><tab_sql><sql name="SQL 1*">ALTER TABLE PET ADD COLUMN foto_url TEXT;
CREATE TABLE IF NOT EXISTS VETERINARIO (
    id_veterinario INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL,
    crmv TEXT UNIQUE NOT NULL,
    especialidade TEXT,
    telefone TEXT,
    email TEXT,
    situacao TEXT DEFAULT 'Ativo'
);

CREATE TABLE IF NOT EXISTS PET (
    id_pet INTEGER PRIMARY KEY AUTOINCREMENT,
    id_tutor INTEGER NOT NULL,
    nome TEXT NOT NULL,
    especie TEXT,
    raca TEXT,
    sexo TEXT,
    data_nascimento TEXT,
    peso REAL,
    cor TEXT,
    observacoes TEXT,
    foto_url TEXT,
    FOREIGN KEY (id_tutor) REFERENCES TUTOR(id_tutor)
);

CREATE TABLE IF NOT EXISTS CONSULTA (
    id_consulta INTEGER PRIMARY KEY AUTOINCREMENT,
    id_tutor INTEGER NOT NULL,
    id_pet INTEGER NOT NULL,
    id_veterinario INTEGER NOT NULL,
    data TEXT NOT NULL,
    horario TEXT NOT NULL,
    descricao TEXT,
    observacoes TEXT,
    status TEXT DEFAULT 'Agendada',
    FOREIGN KEY (id_tutor) REFERENCES TUTOR(id_tutor),
    FOREIGN KEY (id_pet) REFERENCES PET(id_pet),
    FOREIGN KEY (id_veterinario) REFERENCES VETERINARIO(id_veterinario)
);</sql><sql name="SQL 2*">CREATE TABLE IF NOT EXISTS VETERINARIO (
